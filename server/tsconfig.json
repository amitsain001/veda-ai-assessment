{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "esModuleInterop": true,

    "types": ["node"],

    "rootDir": "src",
    "outDir": "dist",

    "sourceMap": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },

  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}